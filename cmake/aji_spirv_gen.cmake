# cmake -DOUT=<file.cpp> -DLIST=<modules.cmake> -P aji_spirv_gen.cmake
# LIST sets NAMES and SPVS (module names and their .spv files; written by aji_spirv_embed).
# Writes the SPIR-V modules as uint32_t arrays (little-endian words, as glslc writes them) and
# the ajivk::kSpirvModules table that src/vk/spirv.h declares.
include("${LIST}")
list(LENGTH NAMES n)
list(LENGTH SPVS n2)
if(n EQUAL 0 OR NOT n EQUAL n2)
    message(FATAL_ERROR "aji_spirv_gen: ${n} names for ${n2} modules")
endif()
set(body "// Generated by cmake/aji_spirv_gen.cmake from src/vk/shaders; do not edit.\n")
string(APPEND body "#include \"vk/spirv.h\"\n\nnamespace ajivk {\nnamespace {\n\n")
set(table "")
set(w "0x[0-9a-f]+u,")
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
    list(GET NAMES ${i} name)
    list(GET SPVS ${i} spv)
    file(READ "${spv}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR rem "${len} % 8")
    if(len EQUAL 0 OR NOT rem EQUAL 0)
        message(FATAL_ERROR "aji_spirv_gen: ${spv} is not a whole number of 32-bit words")
    endif()
    math(EXPR words "${len} / 8")
    # bytes b0 b1 b2 b3 of each little-endian word -> 0xb3b2b1b0u, eight words a line
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," arr "${hex}")
    string(REGEX REPLACE "(${w}${w}${w}${w}${w}${w}${w}${w})" "\\1\n" arr "${arr}")
    string(APPEND body "const uint32_t k_${name}[${words}] = {\n${arr}\n};\n\n")
    string(APPEND table "    {\"${name}\", k_${name}, ${words}},\n")
endforeach()
string(APPEND body "}  // namespace\n\nconst SpirvModule kSpirvModules[] = {\n${table}};\n")
string(APPEND body "const size_t kSpirvModuleCount = ${n};\n\n}  // namespace ajivk\n")
# Always written: an output left older than its inputs would rerun this on every make.
file(WRITE "${OUT}" "${body}")

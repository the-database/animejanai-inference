# cmake -DOUT=<file.cpp> -DNAMES=<a;b;...> -DSPVS=<a.spv;b.spv;...> -P aji_spirv_gen.cmake
# Writes the SPIR-V modules as uint32_t arrays (little-endian words, as glslc writes them) and
# the ajivk::kSpirvModules table that src/vk/spirv.h declares. Run by aji_spirv_embed.
list(LENGTH NAMES n)
list(LENGTH SPVS n2)
if(NOT n EQUAL n2)
    message(FATAL_ERROR "aji_spirv_gen: ${n} names for ${n2} modules")
endif()
set(body "// Generated by cmake/aji_spirv_gen.cmake from src/vk/shaders; do not edit.\n")
string(APPEND body "#include \"vk/spirv.h\"\n\nnamespace ajivk {\nnamespace {\n\n")
set(table "")
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
    list(GET NAMES ${i} name)
    list(GET SPVS ${i} spv)
    file(READ "${spv}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR rem "${len} % 8")
    if(len EQUAL 0 OR NOT rem EQUAL 0)
        message(FATAL_ERROR "aji_spirv_gen: ${spv} is not a whole number of 32-bit words")
    endif()
    math(EXPR words "${len} / 8")
    string(REGEX MATCHALL "........" chunks "${hex}")
    set(arr "")
    set(col 0)
    foreach(c IN LISTS chunks)
        # bytes b0 b1 b2 b3 of a little-endian word -> 0xb3b2b1b0
        string(SUBSTRING "${c}" 0 2 b0)
        string(SUBSTRING "${c}" 2 2 b1)
        string(SUBSTRING "${c}" 4 2 b2)
        string(SUBSTRING "${c}" 6 2 b3)
        string(APPEND arr "0x${b3}${b2}${b1}${b0}u,")
        math(EXPR col "${col} + 1")
        if(col EQUAL 8)
            string(APPEND arr "\n")
            set(col 0)
        endif()
    endforeach()
    string(APPEND body "const uint32_t k_${name}[${words}] = {\n${arr}};\n\n")
    string(APPEND table "    {\"${name}\", k_${name}, ${words}},\n")
endforeach()
string(APPEND body "}  // namespace\n\nconst SpirvModule kSpirvModules[] = {\n${table}};\n")
string(APPEND body "const size_t kSpirvModuleCount = ${n};\n\n}  // namespace ajivk\n")
# Rewrite only on change, so an unchanged shader set doesn't recompile the table.
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL body)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${body}")

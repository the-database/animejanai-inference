#version 450
// 3x3 conv, NHWC fp16, bias + ReLU, on VK_KHR_cooperative_matrix (16x16x16, fp16 accumulate).
// The same tiling as libaji's CUDA k_conv3x3: a workgroup computes TH x 16 output pixels for all
// output channels; its input tile with a one-pixel halo sits in shared memory (pixel stride C+8);
// each subgroup computes WR rows of 16 pixels as an implicit GEMM over 9 taps x C, A from shared,
// B straight from the weight buffer. The accumulators are staged in shared memory and written out
// with bias and ReLU. Defines: C, WARPS (subgroups per workgroup), WR (rows per subgroup).
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x_id = 0) in;

const int TW = 16, TH = WARPS * WR, CP = C + 8, SP = C + 8, KC = C / 16, NT = C / 16, VPP = C / 8;
const int HP = (TH + 2) * (TW + 2);
const int SM_HALO = HP * CP / 8, SM_STAGE = TH * TW * SP / 8;
const int SM = SM_HALO > SM_STAGE ? SM_HALO : SM_STAGE;

layout(push_constant) uniform PC { int H; int W; } pc;
layout(std430, binding = 0) readonly buffer Src { uvec4 src[]; };
layout(std430, binding = 1) readonly buffer Wt { uvec4 wt[]; };     // [9][C][C] fp16
layout(std430, binding = 2) readonly buffer Bias { f16vec2 bias[]; };
layout(std430, binding = 3) writeonly buffer Dst { uvec4 dst[]; };

shared uvec4 sm[SM];

uint relu_bias(uint v, f16vec2 b)
{
    f16vec2 h = unpackFloat2x16(v) + b;
    return packFloat2x16(max(h, f16vec2(0.0)));
}

void main()
{
    const int tid = int(gl_LocalInvocationIndex), nthreads = int(gl_WorkGroupSize.x);
    const int sg = int(gl_SubgroupID);
    const int tx0 = int(gl_WorkGroupID.x) * TW, ty0 = int(gl_WorkGroupID.y) * TH;
    const int H = pc.H, W = pc.W;

    for (int i = tid; i < HP * VPP; i += nthreads) {
        const int px = i / VPP, v = i % VPP;
        const int yy = ty0 - 1 + px / (TW + 2), xx = tx0 - 1 + px % (TW + 2);
        const bool ok = yy >= 0 && yy < H && xx >= 0 && xx < W;
        sm[px * (CP / 8) + v] = ok ? src[(yy * W + xx) * VPP + v] : uvec4(0);
    }
    barrier();

    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[WR][NT];
    [[unroll]] for (int i = 0; i < WR; i++)
        [[unroll]] for (int n = 0; n < NT; n++)
            acc[i][n] = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    const int row0 = sg * WR;

    [[dont_unroll]] for (int t = 0; t < 9; t++) {
        const int dy = t / 3, dx = t % 3;
        [[unroll]] for (int kc = 0; kc < KC; kc++) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b[NT];
            [[unroll]] for (int n = 0; n < NT; n++)
                coopMatLoad(b[n], wt, uint(((t * C + kc * 16) * C + n * 16) / 8), uint(C / 8),
                            gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (int i = 0; i < WR; i++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a;
                coopMatLoad(a, sm, uint(((row0 + i + dy) * (TW + 2) + dx) * (CP / 8) + kc * 2),
                            uint(CP / 8), gl_CooperativeMatrixLayoutRowMajor);
                [[unroll]] for (int n = 0; n < NT; n++) acc[i][n] = coopMatMulAdd(a, b[n], acc[i][n]);
            }
        }
    }
    barrier();  // the halo is no longer read: shared memory becomes the staging tile [TH*TW][SP]

    [[unroll]] for (int i = 0; i < WR; i++)
        [[unroll]] for (int n = 0; n < NT; n++)
            coopMatStore(acc[i][n], sm, uint((row0 + i) * TW * (SP / 8) + n * 2), uint(SP / 8),
                         gl_CooperativeMatrixLayoutRowMajor);
    barrier();

    const int VPR = TW * VPP;
    for (int q = tid; q < TH * VPR; q += nthreads) {
        const int r = q / VPR, w = q % VPR, px = w / VPP, v = w % VPP, oy = ty0 + r, ox = tx0 + px;
        if (oy >= H || ox >= W) continue;
        uvec4 o = sm[(r * TW + px) * (SP / 8) + v];
        o.x = relu_bias(o.x, bias[v * 4 + 0]);
        o.y = relu_bias(o.y, bias[v * 4 + 1]);
        o.z = relu_bias(o.z, bias[v * 4 + 2]);
        o.w = relu_bias(o.w, bias[v * 4 + 3]);
        dst[(oy * W + ox) * VPP + v] = o;
    }
}

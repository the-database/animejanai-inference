#version 450
// Fused 3x3 conv without a matrix extension, for GPUs with 16-lane subgroups (the sg16 family:
// Intel Xe, Mali). The fusion is libaji's CUDA k_conv3x3 (src/native/conv_kernels.cuh); the GEMM
// is register-blocked: each lane owns one output channel of a 16-channel group and accumulates a
// row of 16 pixels. A lane loads its own pixel's 16 input channels from the shared halo tile and
// its own 16 weights (packed per lane); the inputs reach the other lanes through
// subgroupBroadcast with constant lane ids, which Intel's compiler turns into register-region
// operands. fp16 partial sums per tap, then fp32 (the spike's ACC=3). Results go through the
// staging tile (conv_common.glsl) as fp16 pairs, a lane and its neighbour writing one pair.
// Defines: CINP, COUTP, IN, ACT, GATE, OUT, TH (tile rows), RPS (rows per subgroup).
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_subgroup_extended_types_float16 : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : require

const int SM_EXTRA = 0;
#include "conv_common.glsl"

const int NG = COUTP / 16, KC = CINP / 16, NSG = NG * (TH / RPS);
layout(local_size_x = 16 * NSG) in;

layout(std430, binding = 3) readonly buffer Wt { uvec4 wp[]; };     // [9][KC][NG][16 lanes][16 k]
#if GATE == 2
layout(std430, binding = 6) readonly buffer Watt { uvec4 wpa[]; };  // [COUTP/16][NG][16 lanes][16 k]
#endif

void unpack16(uvec4 u0, uvec4 u1, out float16_t v[16])
{
    f16vec2 p;
    p = unpackFloat2x16(u0.x); v[0] = p.x; v[1] = p.y;
    p = unpackFloat2x16(u0.y); v[2] = p.x; v[3] = p.y;
    p = unpackFloat2x16(u0.z); v[4] = p.x; v[5] = p.y;
    p = unpackFloat2x16(u0.w); v[6] = p.x; v[7] = p.y;
    p = unpackFloat2x16(u1.x); v[8] = p.x; v[9] = p.y;
    p = unpackFloat2x16(u1.y); v[10] = p.x; v[11] = p.y;
    p = unpackFloat2x16(u1.z); v[12] = p.x; v[13] = p.y;
    p = unpackFloat2x16(u1.w); v[14] = p.x; v[15] = p.y;
}

// Lane pairs (2j, 2j+1) hold channels (2j, 2j+1) of one pixel: the even lane writes the pair.
void stage(int px, int ch, int lane, float v)
{
    const float16_t h = float16_t(v);
    const float16_t odd = subgroupShuffleXor(h, 1u);
    if ((lane & 1) == 0) sm_set_pair(px * SP + ch, packFloat2x16(f16vec2(h, odd)));
}

void main()
{
    const int tid = int(gl_LocalInvocationIndex), nth = 16 * NSG;
    const int sg = int(gl_SubgroupID), lane = int(gl_SubgroupInvocationID);
    const int tx0 = int(gl_WorkGroupID.x) * TW, ty0 = int(gl_WorkGroupID.y) * TH;
    const int H = pc.H, W = pc.W;

    fill_halo(tid, nth, tx0, ty0, H, W);
    barrier();

    const int g = sg % NG, row0 = (sg / NG) * RPS, ch = g * 16 + lane;
    float tot[RPS][16];
    float16_t acc[RPS][16];
    [[unroll]] for (int r = 0; r < RPS; r++) [[unroll]] for (int m = 0; m < 16; m++) tot[r][m] = 0.0;

    [[dont_unroll]] for (int t = 0; t < 9; t++) {
        const int dy = t / 3, dx = t % 3;
        [[unroll]] for (int r = 0; r < RPS; r++) [[unroll]] for (int m = 0; m < 16; m++) acc[r][m] = float16_t(0.0);
        [[unroll]] for (int kc = 0; kc < KC; kc++) {
            const int wi = (((t * KC + kc) * NG + g) * 16 + lane) * 2;
            float16_t w[16];
            unpack16(wp[wi], wp[wi + 1], w);
            [[unroll]] for (int r = 0; r < RPS; r++) {
                const int ai = ((row0 + r + dy) * (TW + 2) + lane + dx) * (CP / 8) + kc * 2;
                float16_t a[16];
                unpack16(sm[ai], sm[ai + 1], a);
                [[unroll]] for (int k = 0; k < 16; k++)
                    [[unroll]] for (int m = 0; m < 16; m++) acc[r][m] = fma(subgroupBroadcast(a[k], m), w[k], acc[r][m]);
            }
        }
        [[unroll]] for (int r = 0; r < RPS; r++) [[unroll]] for (int m = 0; m < 16; m++) tot[r][m] += float(acc[r][m]);
    }
    barrier();  // the halo is no longer read: shared memory becomes the staging tile

    const float b = float(bias_h[ch]);
#if GATE == 2
    // stage o (biased, fp16), then the 1x1 attention conv over all channels of each pixel
    [[unroll]] for (int r = 0; r < RPS; r++) [[unroll]] for (int m = 0; m < 16; m++)
        stage((row0 + r) * TW + m, ch, lane, tot[r][m] + b);
    barrier();
    float ga[RPS][16];
    [[unroll]] for (int r = 0; r < RPS; r++) {
        [[unroll]] for (int m = 0; m < 16; m++) ga[r][m] = 0.0;
        [[unroll]] for (int kc = 0; kc < COUTP / 16; kc++) {
            const int wi = ((kc * NG + g) * 16 + lane) * 2;
            float16_t w[16];
            unpack16(wpa[wi], wpa[wi + 1], w);
            const int ai = ((row0 + r) * TW + lane) * (SP / 8) + kc * 2;
            float16_t a[16];
            unpack16(sm[ai], sm[ai + 1], a);
            float16_t part[16];
            [[unroll]] for (int m = 0; m < 16; m++) part[m] = float16_t(0.0);
            [[unroll]] for (int k = 0; k < 16; k++)
                [[unroll]] for (int m = 0; m < 16; m++) part[m] = fma(subgroupBroadcast(a[k], m), w[k], part[m]);
            [[unroll]] for (int m = 0; m < 16; m++) ga[r][m] += float(part[m]);
        }
    }
    barrier();  // every subgroup has read o
    [[unroll]] for (int r = 0; r < RPS; r++) [[unroll]] for (int m = 0; m < 16; m++) {
        const float o = float(float16_t(tot[r][m] + b));
        stage((row0 + r) * TW + m, ch, lane, tanh_gate(o, ga[r][m], ch, ty0 + row0 + r, tx0 + m, H, W));
    }
#else
    [[unroll]] for (int r = 0; r < RPS; r++) [[unroll]] for (int m = 0; m < 16; m++)
        stage((row0 + r) * TW + m, ch, lane, epilogue(tot[r][m] + b, ch, ty0 + row0 + r, tx0 + m, H, W));
#endif
    barrier();

    write_out(tid, nth, tx0, ty0, H, W);
}

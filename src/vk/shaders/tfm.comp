    // 16 H, 17 W, 18 U; m0 dst
    const int q = int(gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * 256u) + gl_GlobalInvocationID.x);
    const int H = prm(16), W = prm(17), U = prm(18), fo = prm(19), h = H / U, w = W / U;
    if (q >= h * w) return;
    const int qy = q / w, qx = q % w;
    const Map O = map(0);
    for (int c = 0; c < 3; c++)
        for (int dy = 0; dy < U; dy++)
            for (int dx = 0; dx < U; dx++) st(O, uint(q), c * U * U + dy * U + dx, float(inh[fo + (c * H + U * qy + dy) * W + U * qx + dx]));
    for (int k = 3 * U * U; k < O.stride; k++) st(O, uint(q), k, 0.0);
#elif PASS == 22
    // conf[t][0] = scale * a[t] . b[t]: 16 M, 17 C, 18 scale (float); m0 a, m1 b, m2 conf. 32 lanes a
    // token, each a pair of channels in 64, summed as k_sim's shuffles add them.
    const int lane = int(gl_LocalInvocationIndex) % 32, slot = int(gl_LocalInvocationIndex) / 32;
    const int t = int(gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 8 + slot;
    const int M = prm(16), C = prm(17);
    const Map A = map(0), B = map(1);
    float s = 0.0;
    if (t < M)
        for (int c = 2 * lane; c < C; c += 64) s += ld(A, uint(t), c) * ld(B, uint(t), c) + (c + 1 < C ? ld(A, uint(t), c + 1) * ld(B, uint(t), c + 1) : 0.0);
    ssim[slot][lane] = s;
    barrier();
    for (int k = 16; k > 0; k >>= 1) {
        if (lane < k) ssim[slot][lane] += ssim[slot][lane + k];
        barrier();
    }
    if (lane == 0 && t < M) st(map(2), uint(t), 0, ssim[slot][0] * prmf(18));
#elif PASS == 23
    // out = x * sigmoid(g[t][0]) for c < C, zeros to pad16(C): 16 M, 17 C; m0 x, m1 g, m2 out.
    // A thread 8 channels of a token.
    const int i = int(gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * 256u) + gl_GlobalInvocationID.x);
    const int M = prm(16), C = prm(17), G = (C + 15) / 16 * 2;
    if (i >= M * G) return;
    const int t = i / G, c0 = (i % G) * 8;
    const float k = sigm(ld(map(1), uint(t), 0));
    const Map X = map(0), O = map(2);
    [[unroll]] for (int j = 0; j < 8; j++) st(O, uint(t), c0 + j, c0 + j < C ? ld(X, uint(t), c0 + j) * k : 0.0);
#elif PASS == 24
    // out = x * cm[c] for c < C, zeros to pad16(C): 16 M, 17 C, 18 cm (arena floats); m0 x, m1 out
    const int i = int(gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * 256u) + gl_GlobalInvocationID.x);
    const int M = prm(16), C = prm(17), cm = prm(18), G = (C + 15) / 16 * 2;
    if (i >= M * G) return;
    const int t = i / G, c0 = (i % G) * 8;
    const Map X = map(0), O = map(1);
    [[unroll]] for (int j = 0; j < 8; j++) st(O, uint(t), c0 + j, c0 + j < C ? ld(X, uint(t), c0 + j) * arf[cm + c0 + j] : 0.0);
#elif PASS == 25
    // The input planes at 19 (H x W) bilinearly resized xS (half-pixel, clamped) into dst (16
    // channels, zeros past 3) at SH x SW: 16 H, 17 W, 18 S; m0 dst
    const int p = int(gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * 256u) + gl_GlobalInvocationID.x);
    const int H = prm(16), W = prm(17), S = prm(18), fo = prm(19), OW = S * W;
    if (p >= S * S * H * W) return;
    const int y = p / OW, x = p % OW;
    const float inv = 1.0 / float(S);
    float vy = clamp((float(y) + 0.5) * inv - 0.5, 0.0, float(H - 1)), vx = clamp((float(x) + 0.5) * inv - 0.5, 0.0, float(W - 1));
    const int y0 = int(vy), x0 = int(vx), y1 = min(y0 + 1, H - 1), x1 = min(x0 + 1, W - 1);
    const float fy = vy - float(y0), fx = vx - float(x0);
    const Map O = map(0);
    for (int c = 0; c < 16; c++) {
        float o = 0.0;
        if (c < 3) {
            const int q = fo + c * H * W;
            const float a = float(inh[q + y0 * W + x0]), b = float(inh[q + y0 * W + x1]), cc = float(inh[q + y1 * W + x0]), d = float(inh[q + y1 * W + x1]);
            o = (a * (1.0 - fx) + b * fx) * (1.0 - fy) + (cc * (1.0 - fx) + d * fx) * fy;
        }
        st(O, uint(p), c, o);
    }
#endif
}

#version 450
// aji_frame_diff's 8x8 tiles on Vulkan frames (HLSL cs_frame_diff, CUDA k_tile_diff): one
// invocation per 8x8 tile of a plane with C interleaved components (each component its own tile):
// the tile's mean |b - a| (the larger of the C), max-reduced over the group and folded into the
// accumulator with one atomicMax on the float's bits (they order like the floats for values >= 0).
// The mean is float(sum) * weights[n] for a tile of n pixels, the host's table, so every backend
// gives the same floats. With regions, each tile's signed sum also goes to its cell of the 4x4 grid
// (region rx holds tiles tx * 4 / tiles_x == rx), summed per group in shared memory, added to the
// accumulator as its low 16 bits (unsigned) and s >> 16 (arithmetic), as the HLSL (no 64-bit
// atomics there): the host recombines hi * 65536 + lo.
// di = {w, h, C, regions}, dj = {pitch a, pitch b (bytes), sample kind: 0 u8, 1 u16}. Binding 1 the
// scale / n table. d0 plane a, d1 plane b, d2 the accumulator: dword 0 the max bits, 1-16 the low
// halves, 17-32 the high halves (zeroed by the host).
#extension GL_GOOGLE_include_directive : require
#include "frame_common.glsl"

shared float fd_max[256];
shared int fd_rsum[16];

uint ld_a(uint off, bool u16)
{
    const uint v = d0[off >> 2];
    return u16 ? (v >> ((off & 2u) * 8u)) & 0xffffu : (v >> ((off & 3u) * 8u)) & 0xffu;
}

uint ld_b(uint off, bool u16)
{
    const uint v = d1[off >> 2];
    return u16 ? (v >> ((off & 2u) * 8u)) & 0xffffu : (v >> ((off & 3u) * 8u)) & 0xffu;
}

void main()
{
    const ivec4 di = DI(), dj = DJ();
    const uint gi = gl_LocalInvocationIndex;
    if (gi < 16u) fd_rsum[gi] = 0;
    barrier();
    const uvec3 id = gl_GlobalInvocationID;
    const uint w = uint(di.x), h = uint(di.y), c = uint(di.z);
    const bool u16 = dj.z == 1;
    const uint bs = u16 ? 2u : 1u;
    const uint tiles_x = (w + 7u) >> 3, tiles_y = (h + 7u) >> 3;
    float m = 0.0;
    if (id.x < tiles_x && id.y < tiles_y) {
        const uint x0 = id.x * 8u, y0 = id.y * 8u;
        const uint nx = min(8u, w - x0), ny = min(8u, h - y0);
        uint asum[2] = uint[2](0u, 0u);
        int ssum = 0;
        for (uint y = 0u; y < ny; y++) {
            const uint ra = (y0 + y) * uint(dj.x), rb = (y0 + y) * uint(dj.y);
            for (uint x = 0u; x < nx; x++) {
                for (uint k = 0u; k < c; k++) {
                    const uint e = ((x0 + x) * c + k) * bs;
                    const int d = int(ld_b(rb + e, u16)) - int(ld_a(ra + e, u16));
                    asum[k] += uint(abs(d));
                    ssum += d;
                }
            }
        }
        const float inv = weights[nx * ny];
        for (uint k = 0u; k < c; k++) m = max(m, float(asum[k]) * inv);
        if (di.w != 0 && ssum != 0) {
            const uint r = (id.y * 4u / tiles_y) * 4u + id.x * 4u / tiles_x;
            atomicAdd(fd_rsum[r], ssum);
        }
    }
    fd_max[gi] = m;
    barrier();
    for (uint n = 128u; n > 0u; n >>= 1) {
        if (gi < n) fd_max[gi] = max(fd_max[gi], fd_max[gi + n]);
        barrier();
    }
    if (gi == 0u && fd_max[0] > 0.0) atomicMax(d2[0], floatBitsToUint(fd_max[0]));
    if (di.w != 0 && gi < 16u && fd_rsum[gi] != 0) {
        const int s = fd_rsum[gi];
        atomicAdd(d2[1u + gi], uint(s) & 0xffffu);
        atomicAdd(d2[17u + gi], uint(s >> 16));
    }
}

#version 450
// Temporal models on Vulkan frames (HLSL cs_rgb_diff_partial, cs_temporal_gather), fp16 tensors.
// By PASS:
//   1 diff partial: per 32x8 group, the sum of the mean |a - b| over the three planes of two ring
//     frames. di = {w, h, groups_x}, dj = {a element offset, b element offset}. d0 the ring,
//     d2 partials (a float per group). frame_scd.comp's PASS 2 sums them into the slot's metric.
//   2 gather: window frames -> the [3T][ph][pw] model input. Position z reads the nearest frame on
//     the center's side of the first scene cut between it and the center, w x h frames edge-
//     replicated to pw x ph, two pixels an invocation, z in gl_GlobalInvocationID.z.
//     di = {w, h, pw, ph}, dj = {T, slots 0-5, slots 6-11, slots 12-14} (5 bits per position: the
//     frame's ring slot), floatBitsToUint(qdiv) bit k: the cut metric between positions k and
//     k + 1 is valid, kr = threshold (<= 0: no cuts), kb = 1 / (w * h). d0 the ring, d1 the
//     per-slot cut metrics (float sums), d2 the model input.
#extension GL_GOOGLE_include_directive : require
#include "frame_common.glsl"

float ld16(uint e)
{
    const vec2 v = unpackHalf2x16(d0[e >> 1]);
    return (e & 1u) != 0u ? v.y : v.x;
}

#if PASS == 1
shared float gs[256];

void main()
{
    const ivec4 di = DI(), dj = DJ();
    const uvec3 id = gl_GlobalInvocationID;
    const uint gi = gl_LocalInvocationIndex;
    float d = 0.0;
    if (id.x < uint(di.x) && id.y < uint(di.y)) {
        const uint plane = uint(di.x) * uint(di.y), i = id.y * uint(di.x) + id.x;
        for (uint ch = 0u; ch < 3u; ch++) d += abs(ld16(uint(dj.x) + ch * plane + i) - ld16(uint(dj.y) + ch * plane + i));
        d *= 1.0 / 3.0;
    }
    gs[gi] = d;
    barrier();
    for (uint n = 128u; n > 0u; n >>= 1) {
        if (gi < n) gs[gi] += gs[gi + n];
        barrier();
    }
    if (gi == 0u) d2[gl_WorkGroupID.y * uint(di.z) + gl_WorkGroupID.x] = floatBitsToUint(gs[0]);
}
#elif PASS == 2
uint gather_slot(uint k)
{
    const ivec4 dj = DJ();
    const uint word = k < 6u ? uint(dj.y) : (k < 12u ? uint(dj.z) : uint(dj.w));
    return (word >> ((k % 6u) * 5u)) & 31u;
}

bool gather_cut(uint k)
{
    if (((floatBitsToUint(qdiv()) >> k) & 1u) == 0u) return false;
    return uintBitsToFloat(d1[gather_slot(k + 1u)]) * kb() > kr();
}

void main()
{
    const ivec4 di = DI(), dj = DJ();
    const uint t = uint(dj.x), z = gl_GlobalInvocationID.z, center = (t - 1u) / 2u;
    const uint w = uint(di.x), h = uint(di.y), pw = uint(di.z), ph = uint(di.w);
    const uint x0 = gl_GlobalInvocationID.x * 2u, y = gl_GlobalInvocationID.y;
    if (x0 >= pw || y >= ph || z >= t) return;
    uint e = z;
    if (kr() > 0.0) {
        e = center;
        if (z > center) {
            for (uint k = center; k < z; k++) {
                if (gather_cut(k)) break;
                e = k + 1u;
            }
        } else {
            for (uint k = center; k > z; k--) {
                if (gather_cut(k - 1u)) break;
                e = k - 1u;
            }
        }
    }
    const uint plane = w * h, dplane = pw * ph;
    const uint src = gather_slot(e) * 3u * plane, sy = min(y, h - 1u);
    const uint dst = z * 3u * dplane + y * pw + x0;  // even: pw is
    for (uint ch = 0u; ch < 3u; ch++) {
        const uint row = src + ch * plane + sy * w;
        const float a = ld16(row + min(x0, w - 1u)), b = ld16(row + min(x0 + 1u, w - 1u));
        d2[(dst + ch * dplane) >> 1] = packHalf2x16(vec2(a, b));
    }
}
#endif

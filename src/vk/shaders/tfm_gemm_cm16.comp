#version 450
// tfm.comp's GEMM (PASS 1) on VK_KHR_cooperative_matrix 16x16x16 with fp16 operands and fp32 sums,
// as tfm.cu's mma: same parameters and epilogue. A workgroup is 4 subgroups of 32 for a 64 x 64
// tile, each subgroup a 16-column strip of all 64 rows; the A tile goes through shared memory, W
// loads straight from its buffer, once per tile; the sums are staged in shared memory for the
// element-wise epilogue.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 128) in;

layout(push_constant) uniform PC { int entry; int u0; int u1; int u2; } pc;
layout(std430, binding = 7) readonly buffer Params { ivec4 params[]; };
layout(std430, binding = 2) buffer ArH { float16_t arh[]; };
layout(std430, binding = 2) buffer ArF { float arf[]; };
layout(std430, binding = 2) buffer ArV { uvec4 arv[]; };
layout(std430, binding = 4) readonly buffer WF { float wf[]; };
layout(std430, binding = 5) readonly buffer WH { float16_t wh[]; };

int prm(int k) { return params[pc.entry * 16 + (k >> 2)][k & 3]; }
float prmf(int k) { return intBitsToFloat(prm(k)); }

struct Map {
    uint base;
    int stride, off;
    bool f32, none;
};
Map map(int k)
{
    const int at = k < 4 ? 4 * k : 24;
    Map m;
    m.none = prm(at) < 0;
    m.base = uint(max(prm(at), 0));
    m.stride = prm(at + 1);
    m.off = prm(at + 2);
    m.f32 = prm(at + 3) != 0;
    return m;
}
float ld(Map m, uint pix, int c)
{
    const uint i = m.base + pix * uint(m.stride) + uint(m.off + c);
    return m.f32 ? arf[i] : float(arh[i]);
}
void st(Map m, uint pix, int c, float v)
{
    const uint i = m.base + pix * uint(m.stride) + uint(m.off + c);
    if (m.f32) arf[i] = v;
    else arh[i] = float16_t(v);
}

float erf_(float x)
{
    const float s = sign(x), a = abs(x);
    const float t = 1.0 / (1.0 + 0.3275911 * a);
    return s * (1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-a * a));
}
float act(float v, int a, float slope)
{
    if (a == 1) return 0.5 * v * (1.0 + erf_(v / 1.4140625));
    if (a == 2) return v < 0.0 ? v * slope : v;
    return v;
}

// The GEMM's A element (row r, column k). As a 3x3 conv (im2col, 31 > 0): row r the pixel (r / W,
// r % W) of an H x W map, column k the tap k / CPin (row-major 3x3, zero outside the map), channel
// k % CPin of the input (32 H, 33 W, 34 CPin).
float a_elem(Map A, int r, int k, int M)
{
    if (r >= M) return 0.0;
    if (prm(31) == 0) return ld(A, uint(r), k);
    const int W = prm(33), cp = prm(34), t = k / cp, c = k % cp;
    const int y = r / W + t / 3 - 1, x = r % W + t % 3 - 1;
    if (y < 0 || y >= prm(32) || x < 0 || x >= W) return 0.0;
    return ld(A, uint(y * W + x), c);
}
// 8 channels of the A row from column k (k a multiple of 8), or zeros: the conv's tap and pixel
uvec4 a_vec8(Map A, int r, int k, int M)
{
    if (r >= M) return uvec4(0);
    uint pix = uint(r);
    if (prm(31) != 0) {
        const int W = prm(33), cp = prm(34), t = k / cp;
        const int y = r / W + t / 3 - 1, x = r % W + t % 3 - 1;
        if (y < 0 || y >= prm(32) || x < 0 || x >= W) return uvec4(0);
        pix = uint(y * W + x);
        k = k % cp;
    }
    return arv[(A.base + pix * uint(A.stride) + uint(A.off + k)) >> 3];
}

#define ACC_T coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
#define A_T coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define B_T coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>

const int KC = 32;       // input channels staged a barrier
const int AP = KC + 8;   // A tile row pitch (halfs)
const int CP_ = 68; // staging row pitch (floats)
shared float16_t sa[64 * AP];
shared float sc[64 * CP_];

void main()
{
    const int M = prm(16), K = prm(17), N = prm(18), acti = prm(19), last = prm(20), wo = prm(21), bo = prm(22);
    const int cso = prm(29), a2s = prm(30);
    const float slope = prmf(28);
    const Map A = map(0), O = map(1), A1 = map(2), A2 = map(3);
    const int tid = int(gl_LocalInvocationIndex), sg = int(gl_SubgroupID);
    const int m0 = int(gl_WorkGroupID.y) * 64, n0 = int(gl_WorkGroupID.x) * 64;
    const bool va = !A.f32 && (A.stride & 7) == 0 && (A.base & 7u) == 0u && (A.off & 7) == 0 && (prm(31) == 0 || (prm(34) & 7) == 0);
    ACC_T acc[4];
    [[unroll]] for (int j = 0; j < 4; j++) acc[j] = ACC_T(0.0);
    for (int kb = 0; kb < K; kb += KC) {
        const int kn = min(KC, K - kb);  // a multiple of 16
        // the A tile, 64 rows x kn channels, 8 channels a load
        for (int i = tid; i < 64 * (kn / 8); i += 128) {
            const int r = i / (kn / 8), c = (i % (kn / 8)) * 8, gm = m0 + r;
            if (va) {
                const uvec4 q = a_vec8(A, gm, kb + c, M);
                [[unroll]] for (int j = 0; j < 4; j++) {
                    const f16vec2 h = unpackFloat2x16(q[j]);
                    sa[r * AP + c + 2 * j] = h.x;
                    sa[r * AP + c + 2 * j + 1] = h.y;
                }
            } else {
                [[unroll]] for (int j = 0; j < 8; j++) sa[r * AP + c + j] = float16_t(a_elem(A, gm, kb + c + j, M));
            }
        }
        barrier();
        // subgroup sg: the 16 columns n0 + 16 sg of all 64 rows (one W tile a step, A from shared)
        if (n0 + sg * 16 < N)  // uniform: the same for the whole subgroup
            for (int kk = 0; kk < kn; kk += 16) {
                B_T b;
                coopMatLoad(b, wh, uint(wo + (kb + kk) * N + n0 + sg * 16), uint(N), gl_CooperativeMatrixLayoutRowMajor);
                [[unroll]] for (int i = 0; i < 4; i++) {
                    A_T a;
                    coopMatLoad(a, sa, uint(i * 16 * AP + kk), uint(AP), gl_CooperativeMatrixLayoutRowMajor);
                    acc[i] = coopMatMulAdd(a, b, acc[i]);
                }
            }
        barrier();
    }
    [[unroll]] for (int i = 0; i < 4; i++) coopMatStore(acc[i], sc, uint(i * 16 * CP_ + sg * 16), uint(CP_), gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (int i = tid; i < 64 * 64; i += 128) {
        const int rr = i / 64, cc = i % 64, r = m0 + rr, c = n0 + cc;
        if (r >= M || c >= N) continue;
        float v = sc[rr * CP_ + cc];
        if (bo >= 0) v += wf[bo + c];
        if (last == 0) v = act(v, acti, slope);
        if (cso >= 0) v *= arf[cso + c];
        if (!A1.none) v += ld(A1, uint(r), c);
        if (!A2.none) v += ld(A2, uint(r), c) * (a2s >= 0 ? arf[a2s + c] : 1.0);
        if (last != 0) v = act(v, acti, slope);
        st(O, uint(r), c, v);
    }
}
